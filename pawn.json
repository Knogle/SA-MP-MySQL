{
    "user": "Knogle",
    "repo": "SA-MP-MySQL",
    "resources": [
        {
            "name": "^mysql-.+-[Ll]inux\\.tar\\.gz$",
            "platform": "linux",
            "archive": true,
            "includes": ["mysql-.+\\/pawno\\/include"],
            "plugins": ["mysql-.+\\/components\\/mysql.so"],
            "files": {
                "mysql-.+\\/components\\/libmariadb.so.3": "components/libmariadb.so.3"
            }
        },
        {
            "name": "^mysql-.+-(win32|Win32|Windows)\\.zip$",
            "platform": "windows",
            "archive": true,
            "includes": ["mysql-.+\\/pawno\\/include"],
            "plugins": ["mysql-.+\\/components\\/mysql.dll"],
            "files": {
                "mysql-.+\\/components\\/libmariadb.dll": "components/libmariadb.dll"
            }
        }
    ],
    "runtime": {
        "plugins": ["Knogle/SA-MP-MySQL"]
    },
    "contributors": [
